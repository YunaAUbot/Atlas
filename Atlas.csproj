<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <DefaultItemExcludes>$(DefaultItemExcludes);test/**;**/bin/**;**/obj/**</DefaultItemExcludes>
    <GameHelperHostRoot Condition="Exists('$(MSBuildProjectDirectory)/../../GameHelper/GameHelper.csproj')">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../..'))</GameHelperHostRoot>
    <GameHelperHostRoot Condition="'$(GameHelperHostRoot)' == ''">$(GAMEHELPER2_HOST_ROOT)</GameHelperHostRoot>
    <Version>0.5.5</Version>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>1701;1702;1591</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <Target Name="ValidateGameHelperHost" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(GameHelperHostRoot)/GameHelper/GameHelper.csproj')" Text="Set GAMEHELPER2_HOST_ROOT or GameHelperHostRoot to your GameHelper2-LinuxFork checkout." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="$(GameHelperHostRoot)/GameHelper/GameHelper.csproj">
      <Private>false</Private>
      <CopyLocalSatelliteAssemblies>false</CopyLocalSatelliteAssemblies>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="json\biome.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="json\content.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="json\mapcontent.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="json\maps.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="json\mapratings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="json\ritualmods.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="icons\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>icons\%(Filename)%(Extension)</Link>
    </None>
    <None Update="fonts\DejaVuSans.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="fonts\unifont.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- UI localization dictionaries (<lang-code>.json), read via GameHelper's PluginLocalization. -->
    <None Include="Localization\*.json" CopyToOutputDirectory="PreserveNewest" Link="Localization\%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="CopyFiles" AfterTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)/../../GameHelper/GameHelper.csproj')">
    <Copy SourceFiles="$(OutDir)$(TargetName)$(TargetExt);$(OutDir)$(TargetName).pdb;" DestinationFolder="..\..\GameHelper\$(OutDir)Plugins\$(ProjectName)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(OutDir)json\biome.json;$(OutDir)json\content.json;$(OutDir)json\mapcontent.json;$(OutDir)json\maps.json;$(OutDir)json\mapratings.json;$(OutDir)json\ritualmods.json" DestinationFolder="..\..\GameHelper\$(OutDir)Plugins\$(ProjectName)\json" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(OutDir)fonts\DejaVuSans.ttf;$(OutDir)fonts\unifont.ttf" DestinationFolder="..\..\GameHelper\$(OutDir)Plugins\$(ProjectName)\fonts" SkipUnchangedFiles="true" />
    <ItemGroup>
      <DeployIcons Include="$(OutDir)icons\*.png" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployIcons)" DestinationFolder="..\..\GameHelper\$(OutDir)Plugins\$(ProjectName)\icons" SkipUnchangedFiles="true" Condition="'@(DeployIcons)' != ''" />
    <ItemGroup>
      <LocalizationFiles Include="$(OutDir)Localization\*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(LocalizationFiles)" DestinationFolder="..\..\GameHelper\$(OutDir)Plugins\$(ProjectName)\Localization" SkipUnchangedFiles="true" Condition="'@(LocalizationFiles)' != ''" />
  </Target>

</Project>
